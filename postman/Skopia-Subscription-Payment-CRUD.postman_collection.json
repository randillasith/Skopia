{
  "info": {
    "name": "Skopia FR2 - Subscription & Payment CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Demo-only FR2 APIs. Enable demo billing in H2. Supply real bearer tokens from login, not X-User-Id. DELETE retires/cancels records and preserves transaction history. Run folders in order on a fresh demo database; custom plan names must be unique."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "viewerToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "planId",
      "value": ""
    },
    {
      "key": "subscriptionId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "refundId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Administrator plan CRUD",
      "item": [
        {
          "name": "Create weekly plan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/billing/admin/plans",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planName\": \"WEEKLY\",\n  \"durationDays\": 7,\n  \"price\": 0,\n  \"benefit\": \"Premium video access\",\n  \"adFree\": true,\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP status\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { const data = pm.response.json();",
                  "  pm.collectionVariables.set(\"planId\", data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Read all plans including retired",
          "request": {
            "method": "GET",
